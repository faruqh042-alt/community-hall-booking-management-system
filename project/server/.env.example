# Copy this file to ".env" (same folder) and fill in your real values.
# Never commit your real .env file to version control.

# ---- MySQL Database ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=community_hall_db
DB_PORT=3306

# ---- Server ----
PORT=5000

# ---- JWT (JSON Web Token) Authentication ----
# Use any long, random, secret string here in real projects.
JWT_SECRET=this_is_a_super_secret_key_change_me
JWT_EXPIRES_IN=1d

# ---- Email Notifications (sent to the owner whenever someone books) ----
# The address that RECEIVES the "new booking" email:
ADMIN_EMAIL=faruqh042@gmail.com

# The SMTP account that SENDS the email. Using Gmail is easiest to start
# with — see the "Setting Up Booking Emails" section in README.md for the
# exact steps (you need a Gmail "App Password", NOT your normal password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_app_password
